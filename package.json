{
  "name": "cn-poetry-meter-check",
  "version": "1.0.0",
  "description": "中国古典诗词（近体诗）格律检测算法库 / Chinese classical poetry meter checker (CPMC)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "data",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "poetry",
    "chinese",
    "格律",
    "平仄",
    "押韵",
    "近体诗",
    "诗词",
    "cpmc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MonoKelvin/cn-poetry-meter-check.git"
  },
  "homepage": "https://github.com/MonoKelvin/cn-poetry-meter-check#readme",
  "bugs": {
    "url": "https://github.com/MonoKelvin/cn-poetry-meter-check/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@node-rs/jieba": "^2.0.4",
    "pinyin-pro": "^3.29.5"
  }
}
